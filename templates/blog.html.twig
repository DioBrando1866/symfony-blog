{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PhotographItem-Responsive Theme | Blog</title>

    <!-- Bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="{{ asset('bootstrap/css/bootstrap.min.css') }}">
    <!-- Style css -->
    <link rel="stylesheet" type="text/css" href="{{ asset('css/style.css') }}">
    <!-- Font Awesome icons -->
    <link rel="stylesheet" type="text/css" href="{{ asset('font-awesome/css/font-awesome.min.css') }}">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>

<body id="page-top">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-fixed-top navbar-default">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#menu">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand page-scroll" href="#page-top">
                    <span>[PHOTO]</span>
                </a>
            </div>
            <div class="collapse navbar-collapse navbar-right" id="menu">
                <ul class="nav navbar-nav">
                    <li class="lien"><a href="{{ path('index') }}"><i class="fa fa-home sr-icons"></i> Home</a></li>
                    <li class="lien"><a href="{{ path('about') }}"><i class="fa fa-bookmark sr-icons"></i> About</a>
                    </li>
                    <li class="active lien"><a href="{{ path('blog') }}"><i class="fa fa-file-text sr-icons"></i>
                            Blog</a></li>
                    <li><a href="{{ path('contact') }}"><i class="fa fa-phone-square sr-icons"></i> Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- End of Navigation Bar -->

    <!-- Principal Content Start -->
    <div id="blog" class="container">
        <header class="page-header-block">
            <span class="eyebrow">Journal</span>
            {% if searchTerm is defined and searchTerm %}
            <h1>Results for “{{ searchTerm }}”</h1>
            {% else %}
            <h1>Blog</h1>
            {% endif %}
        </header>

        <div class="row">
            <!-- Posts -->
            <div class="col-xs-12 col-md-8">
                <div id="post-list">
                    {% if total > 0 %}
                    <div class="results-bar glass" role="status">
                        <span class="results-count">
                            <i class="fa fa-file-text-o"></i>
                            Mostrando <strong>{{ posts.iterator|length }}</strong> de <strong>{{ total }}</strong> {{
                            total == 1 ? 'post' : 'posts' }}
                        </span>
                        <span class="results-page">Página {{ page }} <span class="results-sep">/</span> {{ totalPages
                            }}</span>
                        <span class="results-progress" aria-hidden="true">
                            <span style="--value: {{ (page / totalPages * 100)|round }}%"></span>
                        </span>
                    </div>

                    {% for post in posts %}
                    {{ include('partials/_post.html.twig', {'post': post}) }}
                    {% endfor %}

                    {% if searchTerm is defined and searchTerm %}
                    {{ include('partials/_paginador.html.twig', {
                    'page': page,
                    'totalPages': totalPages,
                    'ruta': 'blog_buscar',
                    'parametros': {'searchTerm': searchTerm}
                    }) }}
                    {% else %}
                    {{ include('partials/_paginador.html.twig', {
                    'page': page,
                    'totalPages': totalPages,
                    'ruta': 'blog'
                    }) }}
                    {% endif %}
                    {% else %}
                    <div class="card empty-state text-center">
                        <i class="fa fa-search fa-2x"></i>
                        <p>No posts found.</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Sidebar -->
            <aside class="col-xs-12 col-md-4 sidebar">
                <form id="search-form" class="input-pill" action="{{ path('blog_buscar_post') }}" role="search">
                    <div class="input-group">
                        <input type="search" class="form-control" placeholder="Search posts…" name="searchTerm"
                            value="{{ searchTerm is defined ? searchTerm }}" aria-label="Search posts">
                        <span class="input-group-btn">
                            <button type="submit" class="btn btn-icon btn-primary" aria-label="Search"><i
                                    class="fa fa-search"></i></button>
                        </span>
                    </div>
                </form>

                <div class="card card-sm panel" data-reveal>
                    <div class="panel-heading">
                        <h4>Categories</h4>
                    </div>
                    <div class="panel-body">
                        <ul class="link-list nav">
                            <li><a href="#">Category I</a></li>
                            <li><a href="#">Category II</a></li>
                            <li><a href="#">Category III</a></li>
                            <li><a href="#">Category IV</a></li>
                            <li><a href="#">Category V</a></li>
                        </ul>
                    </div>
                </div>

                <div class="card card-sm glass well" data-reveal>
                    <h4>Soluta</h4>
                    <p class="text-muted" style="margin:0">Quod soluta corrupti earum officia vel inventore vitae
                        quidem, consequuntur odit impedit.</p>
                </div>

                <div class="card card-sm" data-reveal>
                    <h4>Recent posts</h4>
                    {% if recents is defined and recents|length > 0 %}
                    {% for recent in recents %}
                    {{ include('partials/_recent_post.html.twig', {recent: recent}) }}
                    {% endfor %}
                    {% else %}
                    <p class="text-muted" style="margin:0">No recent posts yet.</p>
                    {% endif %}
                </div>
            </aside>
        </div>
    </div>
    <!-- End of Principal Content Start -->

    <!-- Footer -->
    <footer>
        <div class="container text-muted text-center">
            <ul class="list-inline social-buttons">
                <li><a href="#"><i class="fa fa-facebook sr-icons"></i></a></li>
                <li><a href="#"><i class="fa fa-twitter sr-icons"></i></a></li>
                <li><a href="#"><i class="fa fa-google-plus sr-icons"></i></a></li>
            </ul>
            <ul class="list-inline">
                <li class="footer-number"><i class="fa fa-phone sr-icons"></i> (00228)92229954 </li>
                <li><i class="fa fa-envelope sr-icons"></i> kouvenceslas93@gmail.com</li>
            </ul>
            <p>Photography Fanatic Template &copy; 2017</p>
        </div>
    </footer>

    <!-- Jquery -->
    <script type="text/javascript" src="{{ asset('js/jquery.min.js') }}"></script>
    <!-- Bootstrap core Javascript -->
    <script type="text/javascript" src="{{ asset('bootstrap/js/bootstrap.min.js') }}"></script>
    <!-- Plugins -->
    <script type="text/javascript" src="{{ asset('js/jquery.easing.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('js/jquery.magnific-popup.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('js/scrollreveal.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('js/script.js') }}"></script>
</body>

</html>
{% endblock %}