{% extends 'base.html.twig' %}
{% block title %}Images{% endblock %}

{% block body %}
<!-- Principal Content Start -->
<div id="images">
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            <h1>Images</h1>
            {{ form(form, {'attr': {'class':'form-horizontal'}}) }}
            <hr class="divider">
        </div>
        <div class="col-xs-12">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>File</th>
                        <th>Views</th>
                        <th>Likes</th>
                        <th>Downloads</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    {% for image in images %}
                    <tr>
                        <th scope="row">{{ image.id }}</th>
                        <td>
                            <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt=""
                                style="width: 120px; height: auto;">
                        </td>
                        <td>{{ image.numViews }}</td>
                        <td>{{ image.numLikes }}</td>
                        <td>{{ image.numDownloads }}</td>
                        <td>{{ image.category ? image.category.name : '' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Principal Content Start -->
{% endblock %}